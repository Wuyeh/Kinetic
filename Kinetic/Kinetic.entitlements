<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Module 29：2026-10-06 用户批准预设导出，仅写入用户在系统面板选择的位置。 -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- 1.0 Module 28：记住用户链接的 Wallpaper Engine 文件夹（只读安全范围书签）。 -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Modules 43/44: public player metadata/transport; system permission only after explicit Connect. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <key>com.apple.security.scripting-targets</key>
    <dict>
        <key>com.apple.Music</key>
        <array><string>com.apple.Music.playback</string><string>com.apple.Music.library.read</string></array>
        <key>com.spotify.client</key>
        <array><string>com.spotify.playback</string><string>com.spotify.library</string></array>
    </dict>
    <!-- Module 35：仅原生天气的用户主动系统定位；Web Renderer 的定位禁用保持不变。 -->
    <key>com.apple.security.personal-information.location</key>
    <true/>
    <!-- Module 54：Sparkle 2 在沙盒里通过自带的安装服务装更新（https://sparkle-project.org/documentation/sandboxing/）。 -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
    </array>
    <!-- 1.0 Module 9：与 Steam 小助手交换 SteamCMD 下载内容的共享目录（SteamHelperConstants.sharedFolderRelativePath）。 -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>/Library/Application Support/Kinetic Steam/</string>
    </array>
</dict>
</plist>
